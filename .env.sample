# ============================================
# nexow-server — Environment Variables
# ============================================

# --- Service ---
PORT=8000
ENVIRONMENT=development

# --- Supabase ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=your-service-role-secret-key

# --- Oanda ---
OANDA_API_URL=https://api-fxpractice.oanda.com
OANDA_ACCOUNT_ID=your-account-id
OANDA_API_TOKEN=your-api-token

# --- IG ---
IG_API_URL=https://demo-api.ig.com
IG_API_TOKEN=your-api-key
IG_USERNAME=your-ig-username
IG_PASSWORD=your-ig-password

# --- Saxo Bank OpenAPI ---
# SIM: https://gateway.saxobank.com/sim/openapi, auth https://sim.logonvalidation.net
# LIVE: https://gateway.saxobank.com/openapi, auth https://live.logonvalidation.net
SAXO_BASE_URL=https://gateway.saxobank.com/sim/openapi
SAXO_AUTH_URL=https://sim.logonvalidation.net
SAXO_APP_KEY=your-app-key
SAXO_APP_SECRET=your-app-secret
# Production: https://api.nexow.ai/saxo/auth/callback
# Local: http://localhost:8000/saxo/auth/callback (add this URL in Saxo app if allowed)
SAXO_REDIRECT_URI=https://api.nexow.ai/saxo/auth/callback
# When using label=development (e.g. NEXT_PUBLIC_SAXO_REDIRECT_LABEL=development), use this redirect
SAXO_REDIRECT_URI_DEVELOPMENT=http://localhost:8000/saxo/auth/callback
# Optional: 24h token from developer.saxo for dev (skip OAuth)
# SAXO_ACCESS_TOKEN=eyJ...

# --- Redis ---
REDIS_URL=redis://localhost:6379
REDIS_CHANNEL=nexow:market:prices

# --- LLM Providers ---
OPENAI_API_KEY=your-openai-api-key
ANTHROPIC_API_KEY=your-anthropic-api-key
GOOGLE_API_KEY=your-google-api-key
DEEPSEEK_API_KEY=your-deepseek-api-key

# --- External Data ---
TAVILY_API_KEY=your-tavily-api-key
NEWSAPI_KEY=your-newsapi-key
NEWSDATA_API_KEY=your-newsdata-api-key

# --- Market Data Poller ---
POLL_INTERVAL_SECONDS=5
DEFAULT_INSTRUMENTS=["EUR_USD", "GBP_USD", "USD_JPY"]

# --- Worker ---
TICK_INTERVAL_SECONDS=5
PENDING_CHECK_INTERVAL_SECONDS=10
MAX_CONCURRENT_EVALUATIONS=20

# --- WASM Sandbox ---
# When sandbox runs on the same host (e.g. docker-compose): http://sandbox:3001 or http://localhost:3001
# When sandbox runs on a separate server: use that server's URL, e.g. http://sandbox-server-ip:3001
SANDBOX_URL=http://localhost:3001

# --- Frontend (for OAuth redirect after Saxo login) ---
# Where to send the user after Saxo callback. Local: http://localhost:3000, prod: https://nexow.ai
FRONTEND_URL=http://localhost:3000

# --- CORS ---
# Production: add https://nexow.ai so frontend can reach backend if needed
CORS_ORIGINS=["http://localhost:3000", "https://nexow.ai"]
