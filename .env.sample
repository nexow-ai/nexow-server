# ============================================
# nexow-server — Environment Variables
# ============================================

# --- Service ---
PORT=8000
ENVIRONMENT=development

# --- Supabase ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=your-service-role-secret-key

# --- Oanda ---
OANDA_API_URL=https://api-fxpractice.oanda.com
OANDA_ACCOUNT_ID=your-account-id
OANDA_API_TOKEN=your-api-token

# --- Redis ---
REDIS_URL=redis://localhost:6379
REDIS_CHANNEL=nexow:market:prices

# --- LLM Providers ---
OPENAI_API_KEY=your-openai-api-key
ANTHROPIC_API_KEY=your-anthropic-api-key
GOOGLE_API_KEY=your-google-api-key
DEEPSEEK_API_KEY=your-deepseek-api-key

# --- External Data ---
TAVILY_API_KEY=your-tavily-api-key
NEWSAPI_KEY=your-newsapi-key
NEWSDATA_API_KEY=your-newsdata-api-key

# --- Market Data Poller ---
POLL_INTERVAL_SECONDS=5
DEFAULT_INSTRUMENTS=["EUR_USD", "GBP_USD", "USD_JPY"]

# --- Worker ---
TICK_INTERVAL_SECONDS=5
PENDING_CHECK_INTERVAL_SECONDS=10
MAX_CONCURRENT_EVALUATIONS=20

# --- WASM Executor ---
WASM_EXECUTOR_URL=http://localhost:3001

# --- CORS ---
CORS_ORIGINS=["http://localhost:3000"]
